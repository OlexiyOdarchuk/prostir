[Desktop Entry]
Type=Application
Name=Prostir
GenericName=Virtual monitors settings
GenericName[uk]=Налаштування віртуальних моніторів
Comment=Monitors, headsets, sound and look of Prostir on this PC
Comment[uk]=Монітори, шоломи, звук і вигляд Prostir на цьому ПК
Exec=prostir-settings
Icon=prostir
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=VR;XR;Quest;monitor;display;virtual;settings;
StartupWMClass=io.github.OlexiyOdarchuk.Prostir.Settings
# Not in the menu: the one entry is Prostir's (prostir open), which starts Prostir
# and opens this window. This file is for the window itself: its app id finds
# the name and the icon here.
NoDisplay=true
