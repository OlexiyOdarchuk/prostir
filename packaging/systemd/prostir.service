# Started by prostir.socket when a headset comes, by a Quest plugged in by USB
# (70-prostir-quest.rules), or by `prostir open`; it leaves by itself once no headset
# needs it, and the socket waits again. Only while the socket is on: a Quest plugged in
# starts nothing where "Start with the system" is off.
[Unit]
Description=Prostir: virtual monitors for the headset
Documentation=https://prostir.ishawyha.dev
Requisite=prostir.socket
After=prostir.socket

[Service]
Type=exec
ExecStart=/usr/bin/prostir serve
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
