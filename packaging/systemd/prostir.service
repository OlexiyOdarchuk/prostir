# Started by prostir.socket when a headset comes, by a Quest plugged in by USB
# (70-prostir-quest.rules), or by `prostir` (the menu); it leaves by itself once no headset
# needs it, and the socket waits again. Only while the socket is on: a Quest plugged in
# starts nothing where "Start with the system" is off.
[Unit]
Description=Prostir: virtual monitors for the headset
Documentation=https://prostir.ishawyha.dev
Requisite=prostir.socket
After=prostir.socket
# Each start stays a minute at least (it answers what else comes meanwhile), so starts
# are rare; a program that crashes at once still stops after 20 tries in 5 minutes
# instead of restarting for good (systemd's default, 5 in 10 s, would also stop the
# socket for a burst of headsets asking).
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=exec
ExecStart=/usr/bin/prostir serve
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
