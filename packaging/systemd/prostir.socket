# Prostir waits for the headset here while nothing of it runs: a headset that
# connects or asks for this PC starts prostir.service. On by default: Prostir's first
# start enables it for its user (and 80-prostir.preset for new users, where presets
# apply); "Start with the system" in Prostir's menu, or `prostir ctl autostart off`,
# turns it off for good.
[Unit]
Description=Prostir: wait for the headset
Documentation=https://prostir.ishawyha.dev

[Socket]
# Connections from the headset (Wi-Fi, or USB through adb reverse).
ListenStream=0.0.0.0:47830
# Headsets asking for this PC (discovery). Prostir lets only its queries in.
ListenDatagram=0.0.0.0:47831
Accept=no

[Install]
WantedBy=sockets.target
