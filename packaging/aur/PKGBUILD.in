# Generated by .github/workflows/aur.yml from packaging/aur/PKGBUILD.in.
pkgname=prostir-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Extra KDE Plasma and Hyprland monitors in a Meta Quest 3 headset (PC part)"
arch=('x86_64')
url="https://prostir.ishawyha.dev"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'gstreamer' 'gst-plugins-base-libs' 'gst-plugins-good'
         'gst-plugins-bad' 'gst-plugin-pipewire' 'pipewire' 'mesa' 'curl')
optdepends=('kscreen: arranging the monitors on KDE Plasma'
            'intel-media-driver: hardware encoding on Intel graphics'
            'libva-mesa-driver: hardware encoding on AMD graphics'
            'android-tools: connecting the headset over USB'
            'kdialog: the pairing dialog (or zenity, fuzzel, wofi, rofi)'
            'libnotify: notifications'
            'qt6-tools: matching wallpapers on every monitor (qdbus6)')
provides=('prostir')
conflicts=('prostir')
source=("https://github.com/OlexiyOdarchuk/prostir/releases/download/v${pkgver}/prostir-${pkgver}-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "prostir-${pkgver}-x86_64-linux"
  install -Dm755 prostir "${pkgdir}/usr/bin/prostir"
  install -Dm644 packaging/prostir.desktop "${pkgdir}/usr/share/applications/prostir.desktop"
  install -Dm644 packaging/prostir.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/prostir.svg"
  install -Dm644 LICENSE-EXCEPTION.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-EXCEPTION.md"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
